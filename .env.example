# Copy to .env and supply your own server-side credentials.
NVIDIA_API_KEY=
GPT_OSS_API_KEY=
GEMMA_API_KEY=
MUSE_API_KEY=
# Optional hosted generation; requires explicit credit-use opt-in in the UI.
HF_TOKEN=
# Optional future NVIDIA Riva Whisper transcription.
RIVA_API_KEY=

# Optional cloud cognitive simulator; defaults to NVIDIA_API_KEY.
COGNITIVE_API_KEY=
# COGNITIVE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Alternative: COGNITIVE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional cloud Whisper. Without this, an existing local Whisper cache is used.
GROQ_API_KEY=
